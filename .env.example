# 留空时系统明确运行在离线演示模式
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 仅在启用 Neo4j profile 时填写，例如 http://neo4j:7474
NEO4J_HTTP_URL=
NEO4J_USER=neo4j
NEO4J_PASSWORD=coursegraph-password
NEO4J_DATABASE=neo4j

# 可选：中文向量检索 + Qdrant + Cross-Encoder 重排序。
# 首次启用会下载约 90 MB 的中文 Embedding 模型和约 1 GB 的重排序模型。
HYBRID_RAG_ENABLED=false
HYBRID_RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
HYBRID_RAG_RERANK_ENABLED=true
HYBRID_RAG_RERANKER_MODEL=BAAI/bge-reranker-base
HYBRID_RAG_BM25_WEIGHT=0.30
HYBRID_RAG_VECTOR_WEIGHT=0.30
HYBRID_RAG_GRAPH_WEIGHT=0.25
HYBRID_RAG_SOURCE_WEIGHT=0.15
HYBRID_RAG_RERANKER_WEIGHT=0.35
# 留空时使用 COURSEGRAPH_DATA_DIR/qdrant 的本地持久化向量库。
QDRANT_URL=
QDRANT_API_KEY=
